# ─────────────────────────────────────────────────────────────────────────────
# VeriTrace backend configuration. Copy to backend/.env and edit.
# .env is git-ignored. NEVER put these values in the mobile app.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0

# ── Blockchain ───────────────────────────────────────────────────────────────
# local   = Hardhat node (npx hardhat node --hostname 0.0.0.0)  ← primary / demo
# sepolia = public testnet (optional; needs SEPOLIA_RPC_URL + SEPOLIA_MNEMONIC)
CHAIN=local
RPC_URL=http://127.0.0.1:8545
# Custodial HD mnemonic for local. Leave empty to use Hardhat's default test mnemonic
# ("test test ... junk"), whose first 20 accounts are pre-funded on the local node.
MNEMONIC=
# Gas top-up for new/re-activated business wallets (deployer = index 0 pays)
# FUND_AMOUNT_ETH=1
# MIN_BALANCE_ETH=0.1

# Sepolia (optional) — use a SEPARATE mnemonic whose index 0 holds some Sepolia ETH.
SEPOLIA_RPC_URL=
SEPOLIA_MNEMONIC=

# ── Firebase ─────────────────────────────────────────────────────────────────
# Option A: real Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
# Web API key (Project settings → General). Used only by scripts/e2e.js to sign in.
FIREBASE_WEB_API_KEY=

# Option B: local Firebase emulators (npm run emulators in the repo root).
# Uncomment all three to use them instead of a real project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-veritrace

# ── Verification rules ───────────────────────────────────────────────────────
# Defaults; `npm run reset-demo` writes demo-friendly overrides to Firestore settings/verification.
SCAN_FLAG_THRESHOLD=10
DEVICE_FLAG_THRESHOLD=5
MIN_HANDOFF_GAP_SECONDS=30
VERIFY_RATE_LIMIT_PER_MIN=60

# ── ML anomaly service (optional; verification works without it) ────────────
ML_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500
