        {
          "name": "Sign in as manufacturer (Firebase REST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{firebaseSignInUrl}}?key={{webApiKey}}",
              "host": [
                "{{firebaseSignInUrl}}"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{webApiKey}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{makerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stores the ID token in {{idToken}} for the requests that follow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('signed in', () => pm.expect(j.idToken).to.be.a('string'));",
                  "pm.collectionVariables.set('idToken', j.idToken);"
                ]
              }
            }
          ]
        },
